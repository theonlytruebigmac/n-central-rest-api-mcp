{
  "name": "n-central-rest-api-mcp",
  "version": "3.0.0",
  "description": "Unofficial MCP server for the N-central REST API — exposes endpoints as MCP tools with org hierarchy resources and workflow prompts.",
  "type": "module",
  "private": true,
  "main": "index.js",
  "bin": {
    "n-central-rest-api-mcp": "./index.js"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env index.js",
    "start:stdio": "node --env-file-if-exists=.env index.js",
    "start:http": "MCP_PORT=3100 node --env-file-if-exists=.env index.js",
    "test": "node --test test/*.test.js test/contract/*.test.js test/contract/operations/*.test.js test/contract/mcp/*.test.js test/evaluation/*.test.js",
    "test:coverage": "node scripts/check-critical-coverage.js",
    "test:operations": "node --test test/contract/operations/*.test.js",
    "test:mcp": "node --test test/contract/mcp/*.test.js",
    "test:evaluation": "node --test test/evaluation/*.test.js",
    "test:container": "RUN_CONTAINER_SMOKE=1 node --test test/container-smoke.test.js",
    "test:live:read-only": "RUN_LIVE_TESTS=1 NC_WRITE_MODE=read-only MCP_QUIET=1 node --env-file=.env.live-test scripts/live-readonly-smoke.js",
    "evaluation:generate": "node scripts/evaluate-tool-selection.js",
    "evaluation:check": "node scripts/evaluate-tool-selection.js --check",
    "evaluation:live:skills": "RUN_LIVE_UX_EVAL=1 node scripts/evaluate-live-mcp-skills.js",
    "evaluation:live:config": "RUN_LIVE_CONFIG_EVAL=1 node --env-file=.env scripts/evaluate-live-toolset-matrix.js",
    "evaluation:live:all-tools": "RUN_LIVE_ALL_TOOL_EVAL=1 node --env-file=.env scripts/evaluate-live-all-tools.js",
    "coverage:api": "node scripts/generate-api-coverage.js",
    "coverage:api:check": "node --test test/contract/operation-inventory.test.js test/contract/coverage-manifest.test.js test/contract/coverage-report.test.js",
    "migration:generate": "node scripts/generate-migration-guide.js",
    "migration:check": "node scripts/generate-migration-guide.js --check",
    "toolsets:generate": "node scripts/generate-toolset-docs.js",
    "toolsets:check": "node scripts/generate-toolset-docs.js --check",
    "release:readiness:generate": "node scripts/generate-release-readiness.js",
    "release:readiness:check": "node scripts/generate-release-readiness.js --check",
    "release:check": "npm run test:coverage && npm run coverage:api:check && npm run migration:check && npm run toolsets:check && npm run evaluation:check && npm run release:readiness:check && npm run version:check && npm run lint && npm run type-check && npm audit --audit-level=low && npm audit --omit=dev --audit-level=low",
    "version:check": "node scripts/check-version-consistency.js",
    "lint": "eslint .",
    "type-check": "tsc -p tsconfig.json"
  },
  "engines": {
    "node": ">=22.9.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.10.0",
    "eslint-plugin-n": "^18.3.0",
    "globals": "^17.12.0",
    "typescript": "^6.0.3"
  }
}
